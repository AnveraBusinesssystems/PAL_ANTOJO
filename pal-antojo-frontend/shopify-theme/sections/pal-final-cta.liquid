<section class="pa-final" style="--pa-final-bg: {{ section.settings.background }}; --pa-final-text: {{ section.settings.text_color }};">
  <div class="pa-final__inner">
    {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h2>{{ section.settings.heading | escape }}</h2>
    {% if section.settings.text != blank %}<div>{{ section.settings.text }}</div>{% endif %}
    <div class="pa-final__actions">
      {% if section.settings.primary_link != blank and section.settings.primary_label != blank %}<a class="pa-final__primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label | escape }}</a>{% endif %}
      {% if section.settings.secondary_link != blank and section.settings.secondary_label != blank %}<a class="pa-final__secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .pa-final{background:var(--pa-final-bg);color:var(--pa-final-text);padding:clamp(58px,9vw,124px) var(--page-margin);text-align:center}
  .pa-final__inner{width:min(1040px,100%);margin:0 auto}
  .pa-final__inner>p{margin:0 0 12px;color:#e5ad35;font-size:12px;font-weight:850;letter-spacing:.14em;text-transform:uppercase}
  .pa-final h2{margin:0;font-size:clamp(48px,8vw,108px);line-height:.84;letter-spacing:-.055em;text-transform:uppercase}
  .pa-final__inner>div:not(.pa-final__actions){margin:24px auto 0;max-width:650px;font-size:clamp(18px,2vw,24px);line-height:1.45}.pa-final__inner>div p{margin:0}
  .pa-final__actions{display:flex;justify-content:center;gap:12px;margin-top:34px}
  .pa-final__actions a{display:inline-flex;min-height:52px;align-items:center;justify-content:center;padding:14px 22px;border:2px solid currentColor;text-decoration:none;font-size:13px;font-weight:900;letter-spacing:.06em;text-transform:uppercase}
  .pa-final__primary{background:#e5ad35;color:#171714}.pa-final__secondary{color:inherit}
  .pa-final__actions a:focus-visible{outline:3px solid #f5f0e8;outline-offset:4px}
  @media(max-width:749px){.pa-final{padding:64px 16px}.pa-final__actions{flex-direction:column}.pa-final__actions a{width:100%}}
{% endstylesheet %}

{% schema %}
{
  "name": "PAL final CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "READY WHEN YOU ARE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "WHAT ARE YOU CRAVING?" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Build your own mix or explore every flavor.</p>" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "BUILD YOUR BOX" },
    { "type": "url", "id": "primary_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "SHOP ALL FLAVORS" },
    { "type": "url", "id": "secondary_link", "label": "Secondary button link", "default": "/collections/all" },
    { "type": "color", "id": "background", "label": "Background", "default": "#1b4332" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f5f0e8" }
  ],
  "presets": [ { "name": "PAL final CTA" } ]
}
{% endschema %}
