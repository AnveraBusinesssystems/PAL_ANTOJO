<section class="pa-steps" style="--pa-steps-bg: {{ section.settings.background }}; --pa-steps-text: {{ section.settings.text_color }};">
  <div class="pa-steps__inner">
    <div class="pa-steps__heading">
      {% if section.settings.eyebrow != blank %}<p>{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    <ol class="pa-steps__list">
      {% for block in section.blocks %}
        <li {{ block.shopify_attributes }}>
          <span>{{ forloop.index | prepend: '0' }}</span>
          <h3>{{ block.settings.heading | escape }}</h3>
          {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
        </li>
      {% endfor %}
    </ol>
    {% if section.settings.button_link != blank and section.settings.button_label != blank %}
      <a class="pa-steps__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} {% render 'pal-icon', name: 'arrow_right' %}</a>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .pa-steps{background:var(--pa-steps-bg);color:var(--pa-steps-text);padding:clamp(48px,7vw,90px) var(--page-margin)}
  .pa-steps__inner{width:min(1280px,100%);margin:0 auto}
  .pa-steps__heading>p{margin:0 0 10px;color:#e5ad35;font-size:12px;font-weight:850;letter-spacing:.14em;text-transform:uppercase}
  .pa-steps__heading h2{margin:0;font-size:clamp(38px,5vw,68px);line-height:.96;letter-spacing:-.045em}
  .pa-steps__list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));margin:36px 0 0;padding:0;border-block:2px solid currentColor;list-style:none}
  .pa-steps__list li{min-height:290px;padding:32px 28px;display:grid;grid-template-rows:48px minmax(108px,1fr) minmax(48px,auto);justify-items:center;text-align:center}
  .pa-steps__list li+li{border-left:2px solid currentColor}
  .pa-steps__list span{display:grid;width:48px;height:48px;place-items:center;border:1px solid currentColor;border-radius:50%;font-size:13px;font-weight:850;letter-spacing:.12em;text-indent:.12em}
  .pa-steps__list h3{align-self:end;display:flex;min-height:108px;max-width:12ch;align-items:flex-end;justify-content:center;margin:0 0 18px;font-size:clamp(25px,3vw,39px);line-height:.98;text-transform:uppercase}
  .pa-steps__list p{align-self:start;min-height:48px;margin:0;max-width:26ch;font-size:16px;line-height:1.45}
  .pa-steps__button{display:flex;min-height:54px;align-items:center;justify-content:space-between;gap:20px;margin-top:28px;padding:14px 20px;background:#e5ad35;color:#171714;text-decoration:none;font-size:14px;font-weight:900;letter-spacing:.06em;text-transform:uppercase}
  .pa-steps__button:focus-visible{outline:3px solid #f5f0e8;outline-offset:4px}
  @media(max-width:749px){.pa-steps{padding:44px 16px}.pa-steps__list{grid-template-columns:1fr}.pa-steps__list li{min-height:250px;padding:28px 20px;grid-template-rows:48px minmax(92px,1fr) auto}.pa-steps__list li+li{border-left:0;border-top:1px solid currentColor}.pa-steps__list h3{min-height:92px;margin-bottom:14px;font-size:clamp(29px,9vw,38px)}.pa-steps__list p{min-height:0}.pa-steps__button{width:100%}}
{% endstylesheet %}

{% schema %}
{
  "name": "PAL box steps",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BUILD YOUR BOX" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "THREE STEPS. SERIOUS CRUNCH." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "BUILD YOUR BOX" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#1b4332" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f5f0e8" }
  ],
  "blocks": [
    { "type": "step", "name": "Step", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "PICK YOUR BOX" },
      { "type": "text", "id": "text", "label": "Text", "default": "Choose 4, 6, or 10 bags." }
    ] }
  ],
  "presets": [
    { "name": "PAL box steps", "blocks": [
      { "type": "step" },
      { "type": "step", "settings": { "heading": "CHOOSE YOUR CRAVINGS", "text": "Mix the flavors you actually want." } },
      { "type": "step", "settings": { "heading": "ENJOY YOUR ANTOJO", "text": "Unbox, crunch, repeat." } }
    ] }
  ]
}
{% endschema %}
