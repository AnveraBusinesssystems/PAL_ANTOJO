{% liquid
  assign featured_collection = section.settings.featured_collection
  if featured_collection == blank
    assign featured_collection = collections['all']
  endif
%}

<section class="hero" id="top">
  <div class="hero-copy">
    <p class="eyebrow">{{ 'pal.home.hero_eyebrow' | t }}</p>
    <h1>{{ 'pal.home.hero_heading_html' | t }}</h1>
    <p class="hero-sub">{{ 'pal.home.hero_body' | t }}</p>
    <div class="hero-actions">
      <a class="button button-primary" href="#shop-the-lineup">{{ 'pal.home.hero_primary' | t }} {% render 'pal-icon', name: 'arrow_right' %}</a>
      <a class="text-link" href="{{ routes.all_products_collection_url }}?view=build">{{ 'pal.home.hero_secondary' | t }} {% render 'pal-icon', name: 'arrow_right' %}</a>
    </div>
    <p class="hero-benefit">{% render 'pal-icon', name: 'spark' %} {{ 'pal.home.hero_shipping' | t }}</p>
  </div>
  <div class="hero-visual" aria-label="{{ 'pal.home.hero_image_label' | t }}">
    <img src="{{ 'pal-hero-table-mobile.placeholder.svg' | asset_url }}" alt="Placeholder for pal-hero-table-mobile.jpg" width="1536" height="1024" fetchpriority="high" decoding="async">
    <div class="burst" aria-hidden="true"><span>{{ 'pal.home.burst_top' | t }}</span><strong>{{ 'pal.home.burst_middle' | t }}</strong><small>{{ 'pal.home.burst_bottom' | t }}</small></div>
    <p class="vertical-note">{{ 'pal.home.hero_roots' | t }}</p>
  </div>
</section>

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {% for i in (1..2) %}
      <div class="ticker-group"><span>{{ 'pal.home.ticker_roots' | t }}</span><i>{% render 'pal-icon', name: 'diamond' %}</i><span>{{ 'pal.home.ticker_heat' | t }}</span><i>{% render 'pal-icon', name: 'diamond' %}</i><span>{{ 'pal.home.ticker_crunch' | t }}</span><i>{% render 'pal-icon', name: 'diamond' %}</i><span>{{ 'pal.home.ticker_roots' | t }}</span><i>{% render 'pal-icon', name: 'diamond' %}</i><span>{{ 'pal.home.ticker_heat' | t }}</span><i>{% render 'pal-icon', name: 'diamond' %}</i><span>{{ 'pal.home.ticker_crunch' | t }}</span><i>{% render 'pal-icon', name: 'diamond' %}</i></div>
    {% endfor %}
  </div>
</div>

<section class="home-products" id="shop-the-lineup">
  <div class="home-products__heading">
    <div><p class="eyebrow">{{ 'pal.home.products_eyebrow' | t }}</p><h2>{{ 'pal.home.products_heading_html' | t }}</h2></div>
    <p>{{ 'pal.home.products_body' | t }}</p>
  </div>
  <div class="home-product-grid">
    {% for product in featured_collection.products limit: 4 %}
      {% assign selected_variant = product.selected_or_first_available_variant %}
      <article class="home-product-card">
        <a class="home-product-card__image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
          {% if product.featured_image != blank %}
            {{ product.featured_image | image_url: width: 720 | image_tag: widths: '240, 360, 480, 720', sizes: '(min-width: 1100px) 25vw, (min-width: 681px) 50vw, 78vw', loading: 'lazy', alt: product.title }}
          {% endif %}
        </a>
        <div class="home-product-card__copy">
          <a href="{{ product.url }}"><h3>{{ product.title }}</h3></a>
          <p class="home-product-card__price">{{ product.price | money }}</p>
          {% form 'product', product, class: 'pal-quick-add-form' %}
            <input type="hidden" name="id" value="{{ selected_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button class="quick-add" type="submit"{% unless selected_variant.available %} disabled{% endunless %}>
              <span>{% if selected_variant.available %}{{ 'pal.home.quick_add' | t }}{% else %}{{ 'pal.home.sold_out' | t }}{% endif %}</span>
              {% if selected_variant.available %}{% render 'pal-icon', name: 'arrow_right' %}{% endif %}
            </button>
          {% endform %}
        </div>
      </article>
    {% endfor %}
  </div>
  <a class="button home-products__all" href="{{ featured_collection.url | default: routes.all_products_collection_url }}">{{ 'pal.home.shop_all' | t }} {% render 'pal-icon', name: 'arrow_right' %}</a>
</section>

<section class="choose-section">
  <div class="choice-intro"><p class="eyebrow">{{ 'pal.home.choose_eyebrow' | t }}</p><h2>{{ 'pal.home.choose_heading_html' | t }}</h2></div>
  <article class="choice-card choice-surprise"><span class="choice-number">A</span><p class="choice-kicker">{{ 'pal.home.surprise_kicker' | t }}</p><h3>{{ 'pal.home.surprise_heading_html' | t }}</h3><p>{{ 'pal.home.surprise_body' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}?view=build&amp;mode=surprise#build">{{ 'pal.home.surprise_button' | t }} {% render 'pal-icon', name: 'spark' %}</a></article>
  <article class="choice-card choice-build"><span class="choice-number">B</span><p class="choice-kicker">{{ 'pal.home.build_kicker' | t }}</p><h3>{{ 'pal.home.build_heading_html' | t }}</h3><p>{{ 'pal.home.build_body' | t }}</p><a href="{{ routes.all_products_collection_url }}?view=build" class="button">{{ 'pal.home.build_button' | t }} {% render 'pal-icon', name: 'arrow_right' %}</a></article>
</section>

<section class="home-trust" aria-label="{{ 'pal.home.trust_label' | t }}">
  <div><span>01</span><strong>{{ 'pal.home.trust_mexico' | t }}</strong></div>
  <div><span>02</span><strong>{{ 'pal.home.trust_family' | t }}</strong></div>
  <div><span>03</span><strong>{{ 'pal.home.trust_ingredients' | t }}</strong></div>
  <div><span>04</span><strong>{{ 'pal.home.trust_shipping' | t }}</strong></div>
</section>

<section class="texture-section">
  <figure class="texture-image texture-beet"><img src="{{ 'beet-crunch-mobile.placeholder.svg' | asset_url }}" alt="Placeholder for beet-crunch-mobile.jpg" width="1254" height="1254" loading="lazy" decoding="async"><figcaption>{{ 'pal.home.texture_caption' | t }}</figcaption></figure>
  <div class="texture-copy"><p class="eyebrow">{{ 'pal.home.texture_eyebrow' | t }}</p><h2>{{ 'pal.home.texture_heading_html' | t }}</h2><p>{{ 'pal.home.texture_body' | t }}</p><a class="text-link" href="/pages/about-pal-antojo">{{ 'pal.home.story_button' | t }} {% render 'pal-icon', name: 'arrow_right' %}</a></div>
</section>

<section class="closing-section">
  <p class="eyebrow">{{ 'pal.home.closing_eyebrow' | t }}</p>
  <h2>{{ 'pal.home.closing_heading_html' | t }}</h2>
  <a class="button button-primary" href="{{ routes.all_products_collection_url }}?view=build">{{ 'pal.home.closing_button' | t }} {% render 'pal-icon', name: 'arrow_up_right' %}</a>
  <div class="closing-chip closing-chip-one" aria-hidden="true"><img src="{{ 'banana-adobado-feature-mobile.placeholder.svg' | asset_url }}" alt="" width="1254" height="1254" loading="lazy" decoding="async"></div>
</section>

{% schema %}
{
  "name": "Pal Antojo home",
  "settings": [
    {
      "type": "collection",
      "id": "featured_collection",
      "label": "Featured product collection"
    }
  ],
  "presets": [
    {
      "name": "Pal Antojo home"
    }
  ]
}
{% endschema %}
