{% assign catalog = section.settings.collection | default: collections.all %}
<section class="subpage-hero build-hero"><div class="subpage-copy"><p class="eyebrow">THE CRAVING LAB</p><h1>BUILD YOUR<br><em>CRAVING.</em></h1><p>Choose your size. Mix the products. Keep it curious. Build your own and save 10%, or let us choose five and save 15%.</p><button class="button surprise-button" type="button">Surprise me with 5 · Save 15% {% render 'pal-icon', name: 'spark' %}</button></div><div class="subpage-duo"><figure><img src="{{ 'banana-adobado-feature.placeholder.svg' | asset_url }}" alt="Placeholder for banana-adobado-feature.png" width="1254" height="1254"><figcaption>BANANA · ADOBADO</figcaption></figure><figure><img src="{{ 'taro-adobado-feature.placeholder.svg' | asset_url }}" alt="Placeholder for taro-adobado-feature.png" width="1254" height="1254"><figcaption>TARO · ADOBADO</figcaption></figure></div></section>
<section class="builder-section" id="build"><div class="builder-title"><p class="eyebrow">BUILD A BOX · 01</p><h2>BUILD A BOX<br>THAT HITS <em>DIFFERENT.</em></h2><p>Choose 5, 6, or 10 bags. Add up to three of any one product.</p></div><div class="builder-shell">
  <aside class="box-panel"><div class="box-panel-top"><span>YOUR BOX</span><span id="box-size-label">5 BAGS</span></div><div class="box-stage" aria-live="polite"><div class="box-lid"><span>PAL ANTOJO</span><small>OPEN FOR CRAVINGS</small></div><div class="bag-stack" id="bag-stack"><span class="empty-stack">YOUR PICKS<br>LAND HERE</span></div></div><div class="progress-copy"><span id="progress-text">0 of 5 selected</span><span>MAX 3 / PRODUCT</span></div><div class="progress-track"><span id="progress-bar"></span></div></aside>
  <div class="builder-controls"><div class="size-row"><div><span class="step-label">STEP 1</span><h3>Pick your box</h3></div><div class="size-pills" role="radiogroup" aria-label="Box size"><button type="button" class="size-pill is-active" data-size="5" role="radio" aria-checked="true">5</button><button type="button" class="size-pill" data-size="6" role="radio" aria-checked="false">6</button><button type="button" class="size-pill" data-size="10" role="radio" aria-checked="false">10</button></div></div>
    <div class="product-picker-heading"><span class="step-label">STEP 2</span><h3>Choose your cravings</h3></div><div class="picker-list">
      {% for product in catalog.products limit: 20 %}{% assign variant = product.selected_or_first_available_variant %}
        <article class="picker-item{% unless variant.available %} is-sold-out{% endunless %}" data-id="{{ variant.id }}" data-name="{{ product.title | escape }}" data-image="{{ product.featured_image | image_url: width: 240 }}" data-available="{{ variant.available }}">
          {% if product.featured_image %}{{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}<div><h4>{{ product.title }}</h4><p>{{ variant.price | money }}{% unless variant.available %} · SOLD OUT{% endunless %}</p></div><div class="counter"><button type="button" class="minus" aria-label="Remove {{ product.title | escape }}">−</button><span>0</span><button type="button" class="plus" aria-label="Add {{ product.title | escape }}"{% unless variant.available %} disabled{% endunless %}>+</button></div>
        </article>
      {% endfor %}
    </div><button type="button" class="add-box-button" id="add-box" disabled><span>CHOOSE 5 MORE</span><strong><span data-add-box-label>ADD BOX · SAVE 10%</span>{% render 'pal-icon', name: 'arrow_right' %}</strong></button><p class="builder-note" id="builder-note">Fill all 5 spots to unlock your box.</p>
  </div>
</div></section>
<script type="application/json" id="PalBoxConfig">{"cartAddUrl":{{ routes.cart_add_url | json }},"cartUrl":{{ routes.cart_url | json }},"discountUrl":{{ routes.root_url | append: 'discount/' | json }},"varietyCode":"VARIETY15","buildCode":"BUILD10"}</script>
{% schema %}
{"name":"Pal Antojo box builder","settings":[{"type":"collection","id":"collection","label":"Products available in builder"}],"presets":[{"name":"Pal Antojo box builder"}]}
{% endschema %}
