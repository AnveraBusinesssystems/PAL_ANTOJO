<section class="pa-story" style="--pa-story-bg: {{ section.settings.background }}; --pa-story-text: {{ section.settings.text_color }};">
  <div class="pa-story__inner">
    <div class="pa-story__copy">
      {% if section.settings.eyebrow != blank %}<p class="pa-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2>{{ section.settings.heading | escape }}</h2>
      {% if section.settings.text != blank %}<div class="pa-story__text">{{ section.settings.text }}</div>{% endif %}
      <ul class="pa-story__ingredients" aria-label="{{ section.settings.list_label | escape }}">
        {% for block in section.blocks %}<li {{ block.shopify_attributes }}>{{ block.settings.name | escape }}</li>{% endfor %}
      </ul>
      {% if section.settings.button_link != blank and section.settings.button_label != blank %}<a href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} {% render 'pal-icon', name: 'arrow_right' %}</a>{% endif %}
    </div>
    <div class="pa-story__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '480, 720, 960, 1200, 1800', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'lazy' }}
      {% else %}
        <div class="pa-story__placeholder" aria-hidden="true"><span>TARO</span><span>JICAMA</span><span>BEET</span><span>BANANA</span><span>CAULIFLOWER</span></div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .pa-story{background:var(--pa-story-bg);color:var(--pa-story-text);padding:clamp(48px,7vw,92px) var(--page-margin)}
  .pa-story__inner{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);width:min(1280px,100%);margin:0 auto;border:2px solid currentColor}
  .pa-story__copy{padding:clamp(30px,5vw,68px)}
  .pa-story__eyebrow{margin:0 0 12px;color:#9b3025;font-size:12px;font-weight:850;letter-spacing:.14em;text-transform:uppercase}
  .pa-story h2{margin:0;font-size:clamp(38px,5vw,68px);line-height:.94;letter-spacing:-.045em}
  .pa-story__text{margin-top:22px;font-size:clamp(17px,1.7vw,21px);line-height:1.5}
  .pa-story__text p{margin:0}
  .pa-story__ingredients{display:flex;flex-wrap:wrap;gap:8px;margin:26px 0 0;padding:0;list-style:none}
  .pa-story__ingredients li{padding:8px 12px;border:1px solid currentColor;font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
  .pa-story__copy>a{display:inline-flex;min-height:48px;align-items:center;gap:20px;margin-top:28px;color:inherit;font-size:13px;font-weight:850;letter-spacing:.06em;text-transform:uppercase;text-underline-offset:5px}
  .pa-story__media{min-height:520px;border-left:2px solid currentColor;overflow:hidden}
  .pa-story__media img{width:100%;height:100%;object-fit:cover}
  .pa-story__placeholder{display:grid;height:100%;min-height:520px;grid-template-columns:1fr 1fr;align-content:center;gap:2px;padding:clamp(24px,5vw,70px);background:#e5ad35;color:#1b4332}
  .pa-story__placeholder span{padding:20px 12px;border:2px solid currentColor;text-align:center;font-size:clamp(15px,2vw,24px);font-weight:900;letter-spacing:.05em}
  .pa-story__placeholder span:last-child{grid-column:1/-1}
  @media(max-width:899px){.pa-story{padding:44px 16px}.pa-story__inner{grid-template-columns:1fr}.pa-story__copy{padding:32px 22px}.pa-story__media{min-height:360px;border-left:0;border-top:2px solid currentColor}.pa-story__placeholder{min-height:360px;padding:20px}}
{% endstylesheet %}

{% schema %}
{
  "name": "PAL ingredient story",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "NOT YOUR USUAL CHIP AISLE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "REAL INGREDIENTS. BOLD ANTOJOS." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Unexpected fruits and vegetables meet the flavors we crave. Every bag starts with a different kind of crunch.</p>" },
    { "type": "text", "id": "list_label", "label": "Ingredient list accessibility label", "default": "PAL ANTOJO ingredients" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "OUR STORY" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f5f0e8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1b4332" }
  ],
  "blocks": [
    { "type": "ingredient", "name": "Ingredient", "settings": [ { "type": "text", "id": "name", "label": "Name", "default": "Taro" } ] }
  ],
  "presets": [
    { "name": "PAL ingredient story", "blocks": [
      { "type": "ingredient" },
      { "type": "ingredient", "settings": { "name": "Jicama" } },
      { "type": "ingredient", "settings": { "name": "Beet" } },
      { "type": "ingredient", "settings": { "name": "Banana" } },
      { "type": "ingredient", "settings": { "name": "Cauliflower" } }
    ] }
  ]
}
{% endschema %}
