        "custom_liquid": "<section class=\"crunch-discovery\"><div class=\"crunch-inner\"><h2>PICK YOUR CRUNCH</h2><p>Choose your craving: bold vegetable chips or naturally satisfying fruit chips.</p><div class=\"crunch-cards\"><a class=\"crunch-card crunch-veg\" href=\"/collections/vegetable-chips\">Vegetable Chips <span aria-hidden=\"true\">→</span></a><a class=\"crunch-card crunch-fruit\" href=\"/collections/fruit-chips\">Fruit Chips <span aria-hidden=\"true\">→</span></a></div></div></section><style>.crunch-discovery{background:#f5f0e8;color:#1b4332;padding:clamp(28px,5vw,64px) 20px;text-align:center}.crunch-inner{max-width:1100px;margin:0 auto}.crunch-discovery h2{font-size:clamp(2rem,4vw,3.5rem);line-height:1.05;margin:0 0 14px;color:#1b4332}.crunch-discovery p{font-size:1.05rem;max-width:620px;margin:0 auto 28px;color:#1c1c1c}.crunch-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.crunch-card{display:flex;align-items:center;justify-content:space-between;min-height:100px;padding:24px 28px;border-radius:12px;text-decoration:none;font-weight:700;font-size:1.15rem;transition:transform .2s ease}.crunch-card:hover{transform:translateY(-3px)}.crunch-veg{background:#1b4332;color:#f5f0e8}.crunch-fruit{background:#c0392b;color:#fff}.crunch-card span{font-size:1.5rem}@media(max-width:600px){.crunch-cards{grid-template-columns:1fr;gap:12px}.crunch-card{min-height:74px}}</style>",
